cat > .gitignore <<'EOF'
# Build directories
build/
cmake-build-*/
out/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/

# vcpkg installed dependencies
vcpkg_installed/

# Makefile generated by CMake
Makefile

# Executables and binaries
*.out
*.exe
*.o
*.obj
*.so
*.a
*.lib
*.dll

# Logs
*.log

# Editor / IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
config.local.json
secrets.json
EOFconfig/local_config.json
